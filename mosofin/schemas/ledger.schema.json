{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MosoFin/mosofin-diagram/schemas/ledger.schema.json",
  "title": "Mosofin Ledger Diagram",
  "description": "An account map replayed from a general-ledger journal. Accounts are the nodes, flows are authored credit-to-debit relationships, and the ledger block carries dated, sourced events that may only travel authored flows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "stages",
    "accounts",
    "flows",
    "ledger"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "ledger"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "enum": [
            "trace",
            "none"
          ]
        },
        "visual_preset": {
          "enum": [
            "classic",
            "signal-flow",
            "blueprint",
            "editorial"
          ]
        },
        "node_style": {
          "enum": [
            "box",
            "logo"
          ]
        },
        "quality_profile": {
          "enum": [
            "standard",
            "showcase"
          ]
        },
        "view": {
          "enum": [
            "map",
            "city"
          ]
        },
        "views": {
          "$ref": "common.schema.json#/$defs/guidedViews"
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "$ref": "common.schema.json#/$defs/legendMode"
            },
            "entries": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "asset": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "liability": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "equity": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "revenue": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "contra": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "expense": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "default": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "emphasis": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "security": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                },
                "dashed": {
                  "$ref": "common.schema.json#/$defs/legendEntry"
                }
              }
            }
          }
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 360
            },
            {
              "type": "number",
              "minimum": 360
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "sibling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Relative URL or path of the sibling Map/City artifact for the viewer toggle."
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "class",
          "stage",
          "row"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sublabel": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "brand": {
            "$ref": "common.schema.json#/$defs/brandMark"
          },
          "class": {
            "enum": [
              "asset",
              "liability",
              "equity",
              "revenue",
              "contra",
              "expense"
            ]
          },
          "cash": {
            "type": "boolean"
          },
          "stage": {
            "type": "integer",
            "minimum": 0
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 48
          },
          "height": {
            "type": "number",
            "minimum": 36
          },
          "yOffset": {
            "type": "number"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "class"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sublabel": {
            "type": "string",
            "maxLength": 120
          },
          "class": {
            "enum": [
              "customer",
              "vendor",
              "bank",
              "lender",
              "government",
              "employee",
              "owner",
              "processor",
              "other"
            ]
          },
          "grouped": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string"
          },
          "variant": {
            "$ref": "common.schema.json#/$defs/variant"
          },
          "route": {
            "enum": [
              "auto",
              "straight",
              "vertical-channel",
              "bottom-channel",
              "top-channel"
            ]
          },
          "fromSide": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "toSide": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "channelX": {
            "type": "number"
          },
          "channelY": {
            "type": "number"
          },
          "labelAt": {
            "$ref": "common.schema.json#/$defs/point"
          },
          "labelDx": {
            "type": "number"
          },
          "labelDy": {
            "type": "number"
          },
          "labelSegment": {
            "type": "integer",
            "minimum": 0
          },
          "via": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/point"
            }
          },
          "width": {
            "type": "number",
            "minimum": 0.5
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "currency",
        "proof",
        "events"
      ],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/isoDate"
            },
            "end": {
              "$ref": "#/$defs/isoDate"
            }
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "proof": {
          "enum": [
            "authored",
            "csv"
          ]
        },
        "amounts": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "gl",
                "bank",
                "processor"
              ]
            },
            "system": {
              "type": "string",
              "maxLength": 80
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "mapping": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "opening": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "daysPerSecond": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10
            }
          }
        },
        "tieouts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "left": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "right": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "node": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "expected": {
                "type": "number"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "date",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "date": {
                "$ref": "#/$defs/isoDate"
              },
              "edge": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "from": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "kind": {
                "enum": [
                  "journal",
                  "refund",
                  "transfer"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "entity": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "ref": {
                "type": "string",
                "maxLength": 60
              },
              "memo": {
                "type": "string",
                "maxLength": 140
              },
              "row": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "unmapped": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "reason"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/isoDate"
              },
              "ref": {
                "type": "string",
                "maxLength": 60
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "memo": {
                "type": "string",
                "maxLength": 140
              },
              "entity": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "row": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "no-rule",
                  "unknown-edge",
                  "ambiguous-edge",
                  "split-entry",
                  "out-of-period",
                  "unparsed"
                ]
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "maxItems": 8,
          "description": "Named what-if overlays. Projected events ride authored flows with a hollow token style; they never enter tie-outs or the proof line.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "assumptions",
              "events"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "assumptions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Optional. When different from ledger.currency, projected money is labelled not comparable; amounts are never converted."
              },
              "events": {
                "type": "array",
                "maxItems": 500,
                "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "date",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "date": {
                "$ref": "#/$defs/isoDate"
              },
              "edge": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "from": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "kind": {
                "enum": [
                  "journal",
                  "refund",
                  "transfer"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "entity": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "ref": {
                "type": "string",
                "maxLength": 60
              },
              "memo": {
                "type": "string",
                "maxLength": 140
              },
              "row": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
              },
              "unmapped": {
                "type": "array",
                "maxItems": 500,
                "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "reason"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/isoDate"
              },
              "ref": {
                "type": "string",
                "maxLength": 60
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "memo": {
                "type": "string",
                "maxLength": 140
              },
              "entity": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "row": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "no-rule",
                  "unknown-edge",
                  "ambiguous-edge",
                  "split-entry",
                  "out-of-period",
                  "unparsed"
                ]
              }
            }
          }
              }
            }
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  }
}
